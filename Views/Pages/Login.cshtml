@{
    ViewData["Title"] = "Log in";
}

<div class="auth-wrap">
    <div class="container">
        <div class="row justify-content-center">
            <div class="col-md-7 col-lg-5">
                <div class="card-soft p-4 p-md-5 shadow-sm">
                    <div class="text-center mb-4">
                        <span class="brand-mark mx-auto mb-3" style="width:3rem;height:3rem;font-size:1.3rem;">S</span>
                        <h2 class="mb-1">Welcome back</h2>
                        <p class="text-muted">Log in to manage your startups and bookings.</p>
                    </div>
                    <form>
                        <div class="mb-3">
                            <label class="form-label fw-semibold" for="email">Email</label>
                            <input class="form-control" id="email" type="email" placeholder="you@harbour.space" />
                        </div>
                        <div class="mb-2">
                            <label class="form-label fw-semibold" for="password">Password</label>
                            <div class="input-group">
                                <input class="form-control" id="password" type="password" placeholder="••••••••" />
                                <button class="btn btn-outline-primary" type="button" style="border-radius:0 12px 12px 0;">Show</button>
                            </div>
                        </div>
                        <div class="text-end mb-4"><a href="#" class="small">Forgot password?</a></div>
                        <a class="btn btn-primary w-100 mb-3" asp-controller="Pages" asp-action="Profile">Log in</a>
                        <p class="text-center text-muted mb-0">New here? <a asp-controller="Pages" asp-action="Register">Create an account</a></p>
                    </form>
                </div>
            </div>
        </div>
    </div>
</div>
