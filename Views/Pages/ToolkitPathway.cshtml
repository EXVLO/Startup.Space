@{
    ViewData["Title"] = "Founder Pathway";
    ViewData["Section"] = "Toolkit";
    var stages = new[]
    {
        ("Idea", new[] { ("Write the problem in one sentence", true), ("Talk to 10 potential users", true) }),
        ("Validation", new[] { ("Build a landing page", true), ("Collect 50 sign-ups", true), ("Run a pricing test", false) }),
        ("Build", new[] { ("Ship the MVP", false), ("Get 10 active users", false) }),
        ("Launch", new[] { ("Prepare the pitch deck", false), ("Book a mentor review", false), ("Pitch at Demo Day", false) })
    };
}

<section class="page-header">
    <div class="container">
        <span class="eyebrow">Founders Toolkit</span>
        <h1>Founder Pathway</h1>
        <p class="text-muted mb-0">Follow the steps and tick them off in your checklist.</p>
    </div>
</section>

<div class="container section">
    <partial name="_ToolkitNav" />

    <div class="card-soft mb-4 d-flex flex-wrap align-items-center gap-3" id="checklist">
        <div class="flex-grow-1">
            <div class="fw-semibold mb-1">My Checklist</div>
            <div class="progress" style="height:10px;">
                <div class="progress-bar" style="width:40%;background:var(--brand);"></div>
            </div>
        </div>
        <span class="fs-4 fw-bold text-brand">4 / 10</span>
    </div>

    <div class="row g-4">
        @for (var i = 0; i < stages.Length; i++)
        {
            var (stage, tasks) = stages[i];
            <div class="col-md-6 col-lg-3">
                <div class="card-soft">
                    <span class="step-number">@(i + 1)</span>
                    <h5 class="mb-3">@stage</h5>
                    @foreach (var (task, done) in tasks)
                    {
                        <div class="form-check mb-2">
                            <input class="form-check-input" type="checkbox" checked="@done" id="@task.GetHashCode()" />
                            <label class="form-check-label @(done ? "text-muted text-decoration-line-through" : "")" for="@task.GetHashCode()">@task</label>
                        </div>
                    }
                </div>
            </div>
        }
    </div>
</div>
