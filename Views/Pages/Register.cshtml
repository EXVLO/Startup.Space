@{
    ViewData["Title"] = "Create account";
}

<div class="auth-wrap">
    <div class="container">
        <div class="row justify-content-center">
            <div class="col-md-8 col-lg-6">
                <div class="card-soft p-4 p-md-5 shadow-sm">
                    <div class="text-center mb-4">
                        <h2 class="mb-1">Create your account</h2>
                        <p class="text-muted">Every account starts as a founder. An admin can make you a mentor later.</p>
                    </div>
                    <form>
                        <div class="row g-3 mb-3">
                            <div class="col-sm-6">
                                <label class="form-label fw-semibold" for="name">Name</label>
                                <input class="form-control" id="name" placeholder="Nino" />
                            </div>
                            <div class="col-sm-6">
                                <label class="form-label fw-semibold" for="surname">Surname</label>
                                <input class="form-control" id="surname" placeholder="Beridze" />
                            </div>
                        </div>
                        <div class="mb-3">
                            <label class="form-label fw-semibold" for="email">Email</label>
                            <input class="form-control" id="email" type="email" placeholder="you@harbour.space" />
                        </div>
                        <div class="row g-3 mb-4">
                            <div class="col-sm-6">
                                <label class="form-label fw-semibold" for="password">Password</label>
                                <input class="form-control" id="password" type="password" />
                            </div>
                            <div class="col-sm-6">
                                <label class="form-label fw-semibold" for="repeat">Repeat password</label>
                                <input class="form-control" id="repeat" type="password" />
                            </div>
                        </div>
                        <a class="btn btn-primary w-100 mb-3" asp-controller="Pages" asp-action="Profile">Create account</a>
                        <p class="text-center text-muted mb-0">Already have an account? <a asp-controller="Pages" asp-action="Login">Log in</a></p>
                    </form>
                </div>
            </div>
        </div>
    </div>
</div>
