@model StartupLab.Models.ViewModels.Account.RegisterViewModel
@{
    ViewData["Title"] = "Register";
}

<h1>Register</h1>

@foreach (var error in Model.Errors)
{
    <div class="alert alert-danger">@error</div>
}

<form method="post" action="/Register" class="mb-3">
    @Html.AntiForgeryToken()
    <div class="mb-3">
        <label class="form-label" for="name">Name</label>
        <input class="form-control" id="name" name="name" value="@Model.Name" required />
    </div>
    <div class="mb-3">
        <label class="form-label" for="surname">Surname</label>
        <input class="form-control" id="surname" name="surname" value="@Model.Surname" required />
    </div>
    <div class="mb-3">
        <label class="form-label" for="email">Email</label>
        <input class="form-control" id="email" name="email" type="email" value="@Model.Email" required />
    </div>
    <div class="mb-3">
        <label class="form-label" for="password">Password</label>
        <input class="form-control" id="password" name="password" type="password" required />
    </div>
    <div class="mb-3">
        <label class="form-label" for="repeatPassword">Repeat password</label>
        <input class="form-control" id="repeatPassword" name="repeatPassword" type="password" required />
    </div>
    <button type="submit" class="btn btn-primary">Register</button>
</form>

<p><a href="/Login">Already have an account</a></p>
