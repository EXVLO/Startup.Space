@{
    ViewData["Title"] = "Privacy and Policy";
}

<section class="page-header">
    <div class="container">
        <span class="eyebrow">Legal</span>
        <h1>Privacy and Policy</h1>
        <p class="text-muted mb-0">Last updated: October 2026</p>
    </div>
</section>

<div class="container section">
    <div class="row justify-content-center">
        <div class="col-lg-8">
            <div class="card-soft p-4 p-md-5">
                <h4>What we collect</h4>
                <p class="text-muted">Your name, email, profile photo, contacts, and the startups you add.</p>
                <h4 class="mt-4">How we use it</h4>
                <p class="text-muted">To show your public profile and startups, and to let you book mentors.</p>
                <h4 class="mt-4">Your choices</h4>
                <p class="text-muted mb-0">You can edit or delete your data at any time in Settings.</p>
            </div>
        </div>
    </div>
</div>
